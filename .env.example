# Copy this file to .env before running Docker Compose.
# Use a unique password of at least 8 characters, then delete it after the
# first login and password rotation. Do not commit .env.
SERVER_MONITOR_INITIAL_PASSWORD=replace-this-with-a-long-random-password
SERVER_MONITOR_PORT=8000
LOG_LEVEL=INFO

# Optional: set 1 only when the reverse proxy terminates HTTPS.
# SERVER_MONITOR_HTTPS=1
